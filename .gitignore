*.dylib

# Web frontend (src/web) build output & deps
src/web/node_modules/
src/web/dist/
src/web/.vite/
src/web/_tmp_*

# Backup files
*.bak

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
