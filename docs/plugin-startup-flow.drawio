<mxGraphModel adaptiveColors="auto" pageWidth="1200" pageHeight="570">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="后端启动与退出：一个冻结图、一个生命周期" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="lane-0" value="准备阶段" style="swimlane;horizontal=0;startSize=110;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="1200" height="150" as="geometry"/></mxCell>
    <mxCell id="sconfig" value="1. 配置 / 日志&#xa;先于激活冻结" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-0"><mxGeometry x="120" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sdb" value="2. 显式数据库&#xa;连接失败停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-0"><mxGeometry x="300" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sfreeze" value="3. 冻结 / 拓扑排序&#xa;缺依赖 / 冲突即失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-0"><mxGeometry x="480" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="svalidate" value="4. 全部 Validate&#xa;无副作用校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-0"><mxGeometry x="660" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sinit" value="5. 全部 Initialize&#xa;准备资源与契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-0"><mxGeometry x="840" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="lane-1" value="启动阶段" style="swimlane;horizontal=0;startSize=110;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="210" width="1200" height="150" as="geometry"/></mxCell>
    <mxCell id="smigrate" value="6. 按依赖迁移&#xa;Before / Models / After" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-1"><mxGeometry x="120" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sroute" value="7. 中间件 / 路由&#xa;检查所有归属" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-1"><mxGeometry x="300" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sstart" value="8. 全部 Start&#xa;启动可取消 worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-1"><mxGeometry x="480" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sready" value="9. 全部 Ready&#xa;检查真实可用性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-1"><mxGeometry x="660" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sserve" value="10. 监听 HTTP&#xa;此时才能提供服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-1"><mxGeometry x="840" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="lane-2" value="退出 / 失败" style="swimlane;horizontal=0;startSize=110;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="360" width="1200" height="150" as="geometry"/></mxCell>
    <mxCell id="ssignal" value="退出信号或失败&#xa;失败不得继续服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-2"><mxGeometry x="120" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sdrain" value="先排空 HTTP&#xa;已接收请求完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-2"><mxGeometry x="300" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="scancel" value="取消 worker&#xa;关闭阻塞连接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-2"><mxGeometry x="480" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sstop" value="逆依赖顺序 Stop&#xa;含部分初始化 owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-2"><mxGeometry x="660" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="sclose" value="最后关闭数据库&#xa;合并返回清理错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="lane-2"><mxGeometry x="840" y="45" width="140" height="60" as="geometry"/></mxCell>
    <mxCell id="note" value="阶段按编号顺序执行。DisableDatabase 显式跳过数据库和迁移；Stop 协作式限时，不承诺外部副作用自动回滚。" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1160" height="40" as="geometry"/></mxCell>
    <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sconfig" target="sdb" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sdb" target="sfreeze" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sfreeze" target="svalidate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="svalidate" target="sinit" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="smigrate" target="sroute" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sroute" target="sstart" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sstart" target="sready" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sready" target="sserve" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="ssignal" target="sdrain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sdrain" target="scancel" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="scancel" target="sstop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#526b87;endArrow=classic;" edge="1" source="sstop" target="sclose" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root>
